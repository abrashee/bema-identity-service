# Identity Service environment configuration
# Copy to .env for local development.
# Never commit .env.

# JWT
JWT_SECRET=replace_with_a_minimum_32_character_secret
JWT_EXPIRATION=3600000

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bema_identity_db
SPRING_DATASOURCE_USERNAME=replace-with-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-database-password

# Internal services
USER_SERVICE_URL=http://localhost:8081

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Bootstrap administrator
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Login brute-force protection
BRUTE_FORCE_MAX_FAILURES=5
BRUTE_FORCE_FAILURE_WINDOW_SECONDS=900
BRUTE_FORCE_LOCK_SECONDS=900
